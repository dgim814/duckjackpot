{
  "name": "duckjackpot-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test:nft-sale": "node --import tsx --test test/nftSale/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "nft:check-contracts": "node scripts/nft-reference-compile.mjs",
    "nft:testnet-wallet": "node scripts/nft-testnet-wallet.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@ton-community/func-js": "^0.11.0",
    "@ton/sandbox": "^0.45.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "typescript": "~5.9.2"
  }
}
