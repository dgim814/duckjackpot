PORT=3001
ADMIN_PASSWORD=duckadmin2026

# From @BotFather. Do not commit the real token.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the Mini App (frontend). Used for Menu Button and /start.
TELEGRAM_WEBAPP_URL=https://duckjackpot.vercel.app

# Support bot @DuckJackpotSupportBot. Separate token — never share getUpdates with the Mini App bot.
SUPPORT_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Optional. Defaults to https://$RAILWAY_PUBLIC_DOMAIN/api/support-bot/webhook when on Railway.
# Leave empty locally to use dedicated polling for the support bot only.
SUPPORT_BOT_WEBHOOK_URL=
SUPPORT_BOT_WEBHOOK_SECRET=

# Persistent storage. On Railway mount a volume at /data.
# If /data exists it is used automatically. Otherwise ./data
DATA_DIR=

# ---------- Retention: referrals, channel check, notifications ----------
# Official channel for the referral subscription check (getChatMember). Defaults: @DuckJackpot and
# https://t.me/DuckJackpot. The bot must be an ADMIN of the channel.
TELEGRAM_CHANNEL_ID=@DuckJackpot
TELEGRAM_CHANNEL_URL=https://t.me/DuckJackpot
# Automatic notifications: 1 = on, 0 = off. Leave EMPTY to switch them in the admin panel (default off).
NOTIFICATIONS_ENABLED=
# Quiet hours 22:00–09:00 are counted in this UTC offset (default 3 = Moscow).
NOTIFY_TZ_OFFSET=3
# Scheduler interval in ms (default 10 minutes).
NOTIFY_INTERVAL_MS=600000
# Referral rewards in DUCK COIN (defaults 150 for the new player, 300 for the inviter).
REFERRAL_INVITEE_COINS=150
REFERRAL_INVITER_COINS=300
# Telegram Stars owed per successful referral. NOT sent by the bot: they go to the admin
# "⭐ ВЫПЛАТЫ STARS" queue and the operator sends them by hand, then marks them paid.
REFERRAL_INVITER_STARS=10
REFERRAL_INVITEE_STARS=5
# Secret for invite codes (optional; defaults to the bot token). Set it once and keep it.
REFERRAL_SECRET=
