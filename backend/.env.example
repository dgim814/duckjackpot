PORT=3001
ADMIN_PASSWORD=duckadmin2026

# From @BotFather. Do not commit the real token.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the Mini App (frontend). Used for Menu Button and /start.
TELEGRAM_WEBAPP_URL=https://duckjackpot.vercel.app

# Support bot @DuckJackpotSupportBot. Separate token — never share getUpdates with the Mini App bot.
SUPPORT_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Optional. Defaults to https://$RAILWAY_PUBLIC_DOMAIN/api/support-bot/webhook when on Railway.
# Leave empty locally to use dedicated polling for the support bot only.
SUPPORT_BOT_WEBHOOK_URL=
SUPPORT_BOT_WEBHOOK_SECRET=

# Persistent storage. On Railway mount a volume at /data.
# If /data exists it is used automatically. Otherwise ./data
DATA_DIR=

# ---------- Retention: referrals, channel check, notifications ----------
# Official channel for the referral subscription check (getChatMember). Defaults: @DuckJackpot and
# https://t.me/DuckJackpot. The bot must be an ADMIN of the channel.
TELEGRAM_CHANNEL_ID=@DuckJackpot
TELEGRAM_CHANNEL_URL=https://t.me/DuckJackpot
# Automatic notifications: 1 = on, 0 = off. Leave EMPTY to switch them in the admin panel (default off).
NOTIFICATIONS_ENABLED=
# Quiet hours 22:00–09:00 are counted in this UTC offset (default 3 = Moscow).
NOTIFY_TZ_OFFSET=3
# Scheduler interval in ms (default 10 minutes).
NOTIFY_INTERVAL_MS=600000
# Referral rewards in DUCK COIN (defaults 150 for the new player, 300 for the inviter).
REFERRAL_INVITEE_COINS=150
REFERRAL_INVITER_COINS=300
# ⭐ Referral Stars (internal, accumulating): the INVITER earns this per successful friend; every
# full REFERRAL_STARS_PAYOUT block becomes one payout in the admin "⭐ REFERRAL PAYOUTS" queue.
# NOT sent by the bot: the operator sends the Stars by hand, then marks the payout paid.
REFERRAL_STARS_PER_FRIEND=5
REFERRAL_STARS_PAYOUT=50
# Referral mission: DUCK COIN the invited player must bank through successful EXITs (server-counted).
REFERRAL_MISSION_COINS=650
# Secret for invite codes (optional; defaults to the bot token). Set it once and keep it.
REFERRAL_SECRET=

# ---------- 🖼 NFT SALE — Phase 1: TON TESTNET ONLY, no real money ----------
# Separate from the NFT Drop. Off by default: while false the sale screen, HUB card and user endpoints
# are hidden (404). Keep false in production for Phase 1.
NFT_SALE_ENABLED=false
# Only "testnet" is accepted. "mainnet" (or anything else) is refused in every environment.
NFT_NETWORK=testnet
# toncenter = TON testnet via TON Center (default). sandbox = in-memory TVM emulator, dev/test only
# (refused when NODE_ENV=production or RAILWAY_ENVIRONMENT_NAME=production).
NFT_CHAIN=toncenter
# Optional TON Center TESTNET API key (without it: 1 request/second).
TONCENTER_TESTNET_API_KEY=
# SECRET — 24-word mnemonic of the TESTNET minter wallet (collection owner). Railway variable only:
# never commit it, never paste it into code or chat. Generate a fresh wallet just for this.
NFT_TESTNET_MINTER_MNEMONIC=
# Optional: an already deployed testnet collection (otherwise the admin deploys one: NFT SALE → Deploy).
NFT_COLLECTION_ADDRESS=
# Public base URL of this backend for TEP-64 metadata (defaults to https://$RAILWAY_PUBLIC_DOMAIN).
NFT_METADATA_BASE_URL=
# Domains a TON Connect ton_proof may be signed for (the manifest's host).
NFT_PROOF_DOMAINS=duckjackpot.vercel.app
# How long a submitted mint may take before the order is marked FAILED (seconds, default 180).
NFT_MINT_CONFIRM_TIMEOUT_S=180
# Background worker period (expiry + delivery), ms (default 5000).
NFT_WORKER_INTERVAL_MS=5000
